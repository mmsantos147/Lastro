# Copy to .env and adjust. Never commit .env.
# Read by Docker Compose (database) and by the backend when run from backend/ (spring.config.import).

# Database
DB_NAME=lastro
DB_USERNAME=lastro
DB_PASSWORD=lastro
DB_PORT=5432
# If you change DB_NAME or DB_PORT, also set:
# DB_URL=jdbc:postgresql://localhost:<port>/<name>

# First admin, created on startup only when there are no users (password: at least 12 characters)
LASTRO_ADMIN_USERNAME=
LASTRO_ADMIN_PASSWORD=
LASTRO_ADMIN_NAME=

# Session cookie only over HTTPS (true in production)
SESSION_COOKIE_SECURE=false

# Market data (optional). Without a brapi token only PETR4, MGLU3, VALE3 and ITUB4 get quotes and the
# Ibovespa comparison is unavailable. Free token: https://brapi.dev
BRAPI_TOKEN=
# Longest history range your brapi plan accepts (free: 3mo)
BRAPI_MAX_RANGE=3mo

# Public address of the website (links returned by save_analysis)
LASTRO_PUBLIC_URL=http://localhost:5173
# MCP server for Claude: fixed token (Authorization: Bearer <token>) and the user whose portfolio it serves.
# Generate the token with: openssl rand -base64 32
LASTRO_MCP_TOKEN=
LASTRO_MCP_USERNAME=
